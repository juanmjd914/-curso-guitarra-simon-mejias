# ═══════════════════════════════════════════════════════
#  Variables de entorno — Curso de Guitarra · Simón Mejías
#  Renombra este archivo a .env y completa tus valores.
#  NUNCA subas .env a Git (ya está en .gitignore).
# ═══════════════════════════════════════════════════════

# ── Servidor ──────────────────────────────────────────
PORT=3000
NODE_ENV=development

# ── Seguridad ─────────────────────────────────────────
# Token para acceder a GET /api/leads (admin)
ADMIN_TOKEN=cambia_este_token_secreto_ahora

# URL base del sitio (para links en emails y redirects de pago)
BASE_URL=http://localhost:3000

# CORS: URL del frontend en producción
# ALLOWED_ORIGIN=https://simonmejias.cl

# ── Stripe (descomentar cuando integres pagos) ────────
# STRIPE_SECRET_KEY=sk_test_...
# STRIPE_WEBHOOK_SECRET=whsec_...

# ── Webpay Transbank (Chile) ──────────────────────────
# WEBPAY_COMMERCE_CODE=597055555532
# WEBPAY_API_KEY=579B532A7440BB0C9079DED94D31EA1615BACEB56610332264630D42D0A36B1C

# ── Email transaccional (Resend) ──────────────────────
# RESEND_API_KEY=re_...
# EMAIL_FROM=hola@simonmejias.cl
